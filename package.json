{
  "name": "kivo-office",
  "version": "1.0.0",
  "private": true,
  "description": "Kivo Office - self-hosted kanban roadmaps for one company, with invite links, roles per roadmap and an append-only audit log",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.js\"",
    "backup": "node server/backup.js",
    "setup-link": "node server/setup-link.js"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "nodemailer": "^10.4.0"
  }
}
