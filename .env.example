# Copy this file to .env and fill it in. .env is gitignored: never commit it.
# As it is, it works for a plain local `npm start` on http://localhost:3000.

# Port the app listens on when you run it with npm start. In Docker the app
# always listens on 3000 inside the container and this is ignored; use
# HOST_PORT below instead.
PORT=3000

# Docker only: the port on this machine that reaches the app (bound to
# 127.0.0.1). Default 3000.
# HOST_PORT=3000

# Turn this on for a real install behind HTTPS (the Cloudflare tunnel below
# or your own proxy). It makes the session cookie Secure, so over plain http
# nobody can sign in. docker-compose.yml sets it for you.
# NODE_ENV=production

# The address people open, without a trailing slash. Set it for any real
# install: invite and reset links are built from it, links are only emailed
# when it is set, and it is needed behind a proxy that rewrites the Host header.
# APP_URL=https://kivo.example.com

# Where the database (and its backups) live, relative to the project folder.
# Default: data
# DATA_DIR=data

# Set when a proxy or tunnel sits in front of the app (npm start behind nginx,
# for example), so sign-in limits are counted per visitor instead of per
# proxy. 1 = trust one proxy hop. docker-compose.yml always sets 1.
# TRUST_PROXY=1

# Optional email. When all five are set (and APP_URL too), invite and reset
# links are also emailed to the account's address. Leave empty to only use
# the copy box.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kivo Office <kivo@example.com>

# Only for docker compose --profile tunnel: the token of your Cloudflare tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
